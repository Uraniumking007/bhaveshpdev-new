---
/**
 * ContactForm Component
 *
 * A reusable contact form with validation and submission handling.
 * Uses Alpine.js for state management.
 *
 * @example
 * <ContactForm formId="main-contact" />
 */

import Input from '../ui/Input.astro';
import Textarea from '../ui/Textarea.astro';
import Label from '../ui/Label.astro';
import Button from '../ui/Button.astro';

interface ContactFormProps {
	formId?: string;
	class?: string;
}

const { formId = 'contact-form', class: className = '' } = Astro.props;

// Formspree form ID - replace with your own
const FORMSPREE_FORM_ID = import.meta.env.PUBLIC_FORMSPREE_FORM_ID || '';
---

<div id={formId} class={className} x-data="contactForm()">
	<form @submit.prevent="handleSubmit" class="space-y-4" :class="{ 'opacity-50 pointer-events-none': isSubmitting }">
		<!-- Honeypot field -->
		<input
			type="text"
			name="company"
			aria-hidden="true"
			tabindex="-1"
			class="hidden"
			autocomplete="off"
			x-model="formData.company"
		/>

		<!-- Name Field -->
		<div>
			<Label for="name-{formId}">Name</Label>
			<Input
				id="name-{formId}"
				name="name"
				placeholder="Your name"
				required
				x-model="formData.name"
			/>
			<p
				x-show="errors.name"
				class="text-red-500 text-sm mt-1"
				x-text="errors.name"
				aria-live="assertive"
				style="display: none;"
			></p>
		</div>

		<!-- Email Field -->
		<div>
			<Label for="email-{formId}">Email</Label>
			<Input
				id="email-{formId}"
				name="email"
				type="email"
				placeholder="your.email@example.com"
				required
				x-model="formData.email"
			/>
			<p
				x-show="errors.email"
				class="text-red-500 text-sm mt-1"
				x-text="errors.email"
				aria-live="assertive"
				style="display: none;"
			></p>
		</div>

		<!-- Message Field -->
		<div>
			<Label for="message-{formId}">Message</Label>
			<Textarea
				id="message-{formId}"
				name="message"
				placeholder="Your message..."
				rows={4}
				required
				x-model="formData.message"
			/>
			<p
				x-show="errors.message"
				class="text-red-500 text-sm mt-1"
				x-text="errors.message"
				aria-live="assertive"
				style="display: none;"
			></p>
		</div>

		<!-- Submit Button -->
		<Button
			type="submit"
			variant="default"
			size="md"
			class="w-full text-white"
			:disabled="isSubmitting"
			client:load
		>
			<span x-show="!isSubmitting" class="inline-block">Send Message</span>
			<span x-show="isSubmitting" class="flex items-center justify-center">
				<svg class="animate-spin h-5 w-5 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
				</svg>
				Sending...
			</span>
		</Button>

		<!-- Success Message -->
		<div
			x-show="submitted && success"
			x-transition:enter="transition ease-out duration-300"
			x-transition:enter-start="opacity-0 -translate-y-2"
			x-transition:enter-end="opacity-100 translate-y-0"
			class="flex items-center gap-2 text-green-600 mt-2"
			aria-live="polite"
			style="display: none;"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
			</svg>
			<span>Message sent successfully!</span>
		</div>

		<!-- Error Message -->
		<div
			x-show="submitted && !success"
			x-transition:enter="transition ease-out duration-300"
			x-transition:enter-start="opacity-0 -translate-y-2"
			x-transition:enter-end="opacity-100 translate-y-0"
			class="text-red-600 mt-2"
			aria-live="assertive"
			x-text="error"
			style="display: none;"
		></div>
	</form>
</div>

<script define:vars={{ FORMSPREE_FORM_ID }}>
	function contactForm() {
		return {
			isSubmitting: false,
			submitted: false,
			success: false,
			error: null,
			formData: {
				company: '',
				name: '',
				email: '',
				message: ''
			},
			errors: {
				name: '',
				email: '',
				message: ''
			},

			async handleSubmit() {
				// Check honeypot
				if (this.formData.company.trim().length > 0) {
					return;
				}

				// Clear errors
				this.errors = { name: '', email: '', message: '' };
				this.error = null;
				this.submitted = false;

				// Validation
				let isValid = true;

				if (!this.formData.name.trim()) {
					this.errors.name = 'Name is required';
					isValid = false;
				}

				if (!this.formData.email.trim()) {
					this.errors.email = 'Email is required';
					isValid = false;
				} else {
					const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
					if (!emailRegex.test(this.formData.email)) {
						this.errors.email = 'Please provide a valid email';
						isValid = false;
					}
				}

				if (!this.formData.message.trim()) {
					this.errors.message = 'Message is required';
					isValid = false;
				}

				if (!isValid) return;

				this.isSubmitting = true;

				try {
					if (FORMSPREE_FORM_ID) {
						const response = await fetch(`https://formspree.io/f/${FORMSPREE_FORM_ID}`, {
							method: 'POST',
							body: JSON.stringify({
								name: this.formData.name,
								email: this.formData.email,
								message: this.formData.message,
							}),
							headers: {
								'Accept': 'application/json',
								'Content-Type': 'application/json',
							},
						});

						if (response.ok) {
							this.success = true;
							this.submitted = true;
							this.formData = { company: '', name: '', email: '', message: '' };
						} else {
							const result = await response.json();
							this.success = false;
							this.submitted = true;
							this.error = result.error || 'Something went wrong. Please try again.';
						}
					} else {
						// Fallback to API endpoint
						const formData = new FormData();
						formData.append('company', this.formData.company);
						formData.append('name', this.formData.name);
						formData.append('email', this.formData.email);
						formData.append('message', this.formData.message);

						const response = await fetch('/api/contact', {
							method: 'POST',
							body: formData,
						});

						const result = await response.json();

						if (result.success) {
							this.success = true;
							this.submitted = true;
							this.formData = { company: '', name: '', email: '', message: '' };
						} else {
							this.success = false;
							this.submitted = true;
							this.error = result.error || 'Something went wrong. Please try again.';
						}
					}
				} catch (err) {
					this.success = false;
					this.submitted = true;
					this.error = 'Failed to send message. Please try again.';
				} finally {
					this.isSubmitting = false;
				}
			}
		}
	}

	// Register Alpine component
	(document.defaultView || window).Alpine?.data('contactForm', contactForm);
</script>
