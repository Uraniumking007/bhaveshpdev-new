---
/**
 * Contact Section Component
 *
 * Displays contact form and contact information.
 * Uses Alpine.js for form state management and validation.
 *
 * NOTE: For static builds, this form uses a third-party service (Formspree).
 * To use your own Formspree form ID, update the FORMSPREE_FORM_ID below.
 * Alternatively, set output: 'server' in astro.config.mjs to use the API endpoint.
 */

import Input from "../ui/Input.astro";
import Textarea from "../ui/Textarea.astro";
import Label from "../ui/Label.astro";
import LitupBorderButton from "../Buttons/LitupBorderButton.astro";

// Formspree form ID - replace with your own or set to null to use API endpoint
const FORMSPREE_FORM_ID = import.meta.env.PUBLIC_FORMSPREE_FORM_ID || "";

const contactInfo = [
  {
    id: 0,
    title: "G-Mail",
    description: "contact@bhaveshp.dev",
    icon: "/icons/outline/brand-gmail.svg",
    link: "mailto:contact@bhaveshp.dev",
  },
  {
    id: 1,
    title: "Discord",
    description: "discord.gg/smCjSmMw9D",
    icon: "/icons/outline/brand-discord.svg",
    link: "https://discord.gg/smCjSmMw9D",
  },
  {
    id: 2,
    title: "X",
    description: "x.com/UraniumKing0",
    icon: "/icons/outline/brand-x.svg",
    link: "https://x.com/UraniumKing0",
  },
  {
    id: 3,
    title: "Github",
    description: "github.com/Uraniumking007",
    icon: "/icons/outline/brand-github.svg",
    link: "https://github.com/Uraniumking007",
  },
];

// Generate unique ID for this component instance
const sectionId = `contact-${Math.random().toString(36).substr(2, 9)}`;
---

<div id={sectionId} class="w-screen h-fit min-h-screen" x-data="contactForm()">
  <div class="container mx-auto px-4 py-20">
    <h2
      class="text-3xl font-bold text-center mb-12 text-neutral-700 dark:text-white"
    >
      Get in Touch
    </h2>

    <p class="text-center mb-12 text-neutral-600 dark:text-neutral-300">
      Have a question or want to work together? Feel free to reach out!
    </p>

    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Contact Form -->
        <div
          class="bg-neutral-900/50 dark:bg-neutral-800/50 backdrop-blur-sm rounded-lg p-6 shadow-lg"
        >
          <form
            @submit.prevent="handleSubmit"
            class="space-y-4"
            :class="{ 'opacity-50 pointer-events-none': isSubmitting }"
          >
            <!-- Honeypot field to deter bots -->
            <input
              type="text"
              name="company"
              aria-hidden="true"
              tabindex="-1"
              class="hidden"
              autocomplete="off"
              x-model="formData.company"
            />

            <!-- Name Field -->
            <div>
              <Label for="name">Name</Label>
              <Input
                id="name"
                name="name"
                placeholder="Your name"
                required
                x-model="formData.name"
              />
              <p
                x-show="errors.name"
                class="text-red-500 text-sm mt-1"
                x-text="errors.name"
                aria-live="assertive"
                style="display: none;"
              >
              </p>
            </div>

            <!-- Email Field -->
            <div>
              <Label for="email">Email</Label>
              <Input
                id="email"
                name="email"
                type="email"
                placeholder="your.email@example.com"
                required
                x-model="formData.email"
              />
              <p
                x-show="errors.email"
                class="text-red-500 text-sm mt-1"
                x-text="errors.email"
                aria-live="assertive"
                style="display: none;"
              >
              </p>
            </div>

            <!-- Message Field -->
            <div>
              <Label for="message">Message</Label>
              <Textarea
                id="message"
                name="message"
                placeholder="Your message..."
                rows="4"
                required
                x-model="formData.message"
              />
              <p
                x-show="errors.message"
                class="text-red-500 text-sm mt-1"
                x-text="errors.message"
                aria-live="assertive"
                style="display: none;"
              >
              </p>
            </div>

            <!-- Submit Button -->
            <LitupBorderButton
              type="submit"
              class="w-full"
              :disabled="isSubmitting"
            >
              <div class="flex items-center justify-center gap-2 text-white font-medium">
                <span x-show="!isSubmitting">Send Message</span>
                <span
                  x-show="isSubmitting"
                  class="flex items-center justify-center"
                >
                  <svg
                    class="animate-spin h-5 w-5 mr-2"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                  >
                    <circle
                      class="opacity-25"
                      cx="12"
                      cy="12"
                      r="10"
                      stroke="currentColor"
                      stroke-width="4"></circle>
                    <path
                      class="opacity-75"
                      fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                    ></path>
                  </svg>
                  Sending...
                </span>
              </div>
            </LitupBorderButton>

            <!-- Success Message -->
            <div
              x-show="submitted && success"
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0 -translate-y-2"
              x-transition:enter-end="opacity-100 translate-y-0"
              class="flex items-center gap-2 text-green-600 mt-2"
              aria-live="polite"
              style="display: none;"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>Message sent successfully!</span>
            </div>

            <!-- Error Message -->
            <div
              x-show="submitted && !success"
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0 -translate-y-2"
              x-transition:enter-end="opacity-100 translate-y-0"
              class="text-red-600 mt-2"
              aria-live="assertive"
              x-text="error"
              style="display: none;"
            >
            </div>
          </form>
        </div>

        <!-- Contact Information -->
        <div
          class="bg-neutral-900/50 dark:bg-neutral-800/50 backdrop-blur-sm rounded-lg p-6 shadow-lg"
        >
          <h3 class="text-xl font-semibold mb-4 text-white">
            Contact Information
          </h3>
          <div class="space-y-4">
            <p class="text-neutral-300">
              Feel free to reach out to me through the contact form or using the
              following methods:
            </p>
            <div
              class="flex flex-row gap-4 items-center justify-center mt-6 w-full"
            >
              {
                contactInfo.map((item) => (
                  <a
                    href={item.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-3 rounded-full bg-white/10 dark:bg-neutral-700/50 hover:bg-white/20 transition-colors group"
                    aria-label={item.title}
                    title={item.title}
                  >
                    <img
                      src={item.icon}
                      alt={item.title}
                      class="w-6 h-6 group-hover:scale-110 transition-transform"
                    />
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ FORMSPREE_FORM_ID }}>
  function contactForm() {
    return {
      isSubmitting: false,
      submitted: false,
      success: false,
      error: null,
      formData: {
        company: "",
        name: "",
        email: "",
        message: "",
      },
      errors: {
        name: "",
        email: "",
        message: "",
      },

      async handleSubmit() {
        // Check honeypot - if filled, it's a bot
        if (this.formData.company.trim().length > 0) {
          console.warn("Bot detected via honeypot");
          return;
        }

        // Clear previous errors
        this.errors = { name: "", email: "", message: "" };
        this.error = null;
        this.submitted = false;

        // Client-side validation
        let isValid = true;

        if (!this.formData.name.trim()) {
          this.errors.name = "Name is required";
          isValid = false;
        }

        if (!this.formData.email.trim()) {
          this.errors.email = "Email is required";
          isValid = false;
        } else {
          // Email validation
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(this.formData.email)) {
            this.errors.email = "Please provide a valid email";
            isValid = false;
          }
        }

        if (!this.formData.message.trim()) {
          this.errors.message = "Message is required";
          isValid = false;
        }

        if (!isValid) {
          return;
        }

        this.isSubmitting = true;

        try {
          // Use Formspree if configured, otherwise fallback to API
          if (FORMSPREE_FORM_ID) {
            // Submit to Formspree
            const response = await fetch(
              `https://formspree.io/f/${FORMSPREE_FORM_ID}`,
              {
                method: "POST",
                body: JSON.stringify({
                  name: this.formData.name,
                  email: this.formData.email,
                  message: this.formData.message,
                }),
                headers: {
                  Accept: "application/json",
                  "Content-Type": "application/json",
                },
              }
            );

            const result = await response.json();

            if (response.ok) {
              this.success = true;
              this.submitted = true;
              this.error = null;
              // Reset form after successful submission
              this.formData = {
                company: "",
                name: "",
                email: "",
                message: "",
              };
            } else {
              this.success = false;
              this.submitted = true;
              this.error =
                result.error || "Something went wrong. Please try again.";
            }
          } else {
            // Submit to API endpoint
            const formData = new FormData();
            formData.append("company", this.formData.company);
            formData.append("name", this.formData.name);
            formData.append("email", this.formData.email);
            formData.append("message", this.formData.message);

            const response = await fetch("/api/contact", {
              method: "POST",
              body: formData,
            });

            const result = await response.json();

            if (result.success) {
              this.success = true;
              this.submitted = true;
              this.error = null;
              // Reset form after successful submission
              this.formData = {
                company: "",
                name: "",
                email: "",
                message: "",
              };
            } else {
              this.success = false;
              this.submitted = true;
              this.error =
                result.error || "Something went wrong. Please try again.";
            }
          }
        } catch (err) {
          this.success = false;
          this.submitted = true;
          this.error = "Failed to send message. Please try again.";
          console.error("Form submission error:", err);
        } finally {
          this.isSubmitting = false;
        }
      },
    };
  }

  // Register Alpine component
  (document.defaultView || window).Alpine?.data("contactForm", contactForm);
</script>
