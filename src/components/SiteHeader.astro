---
// SiteHeader.astro - Site-wide header with logo and navigation
interface SiteHeaderProps {
  title?: string;
  tagline?: string;
  showNavigation?: boolean;
  class?: string;
}

const {
  title = 'Bhavesh Patil',
  tagline = 'Full Stack Developer',
  showNavigation = true,
  class: className = ''
} = Astro.props;
---

<header class={`site-header ${className}`}>
  <div class="container mx-auto px-4 py-6">
    <div class="flex items-center justify-between">
      <!-- Logo/Title -->
      <div class="flex items-center space-x-4">
        <a href="/" class="flex items-center space-x-2 group">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-blue-500 flex items-center justify-center text-white font-bold text-lg group-hover:scale-110 transition-transform">
            BP
          </div>
          <div>
            <h1 class="text-xl font-bold text-white group-hover:text-purple-400 transition-colors">
              {title}
            </h1>
            <p class="text-sm text-neutral-400">{tagline}</p>
          </div>
        </a>
      </div>

      <!-- Optional Navigation -->
      {showNavigation && (
        <slot name="navigation">
          <!-- Navigation can be inserted here or passed as slot -->
        </slot>
      )}
    </div>
  </div>
</header>

<style>
  /* Header styles */
  .site-header {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  /* Logo animation */
  a {
    text-decoration: none;
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .site-header {
      padding: 1rem 0;
    }

    h1 {
      font-size: 1.1rem;
    }

    p {
      font-size: 0.8rem;
    }
  }
</style>
