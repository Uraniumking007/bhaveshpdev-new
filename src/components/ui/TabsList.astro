---
/**
 * TabsList Component - Astro + Alpine.js
 * Container for tab triggers with keyboard navigation
 */

interface TabsListProps {
  class?: string;
  loop?: boolean;
  orientation?: 'horizontal' | 'vertical';
  [key: string]: any;
}

const { class: className, loop = true, orientation = 'horizontal', ...props } = Astro.props;
---

<div
  data-slot="tabs-list"
  role="tablist"
  :aria-orientation="orientation"
  class="bg-muted text-muted-foreground inline-flex h-9 w-fit items-center justify-center rounded-lg p-[3px] {className}"
  {...props}
>
  <slot />
</div>
