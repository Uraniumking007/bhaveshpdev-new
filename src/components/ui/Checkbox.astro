---
/**
 * Checkbox Component - Astro version
 * Accessible checkbox component with visual state management
 * Uses native checkbox with CSS-based check icon
 */
interface CheckboxProps {
  checked?: boolean;
  disabled?: boolean;
  required?: boolean;
  name?: string;
  value?: string;
  id?: string;
  class?: string;
  autofocus?: boolean;
  form?: string;
}

const {
  checked = false,
  disabled = false,
  required = false,
  id,
  name,
  value,
  class: className,
  autofocus,
  form,
  ...rest
} = Astro.props;

// Generate unique ID if not provided
const checkboxId = id || `checkbox-${Math.random().toString(36).substring(2, 9)}`;

// Merge default classes with custom classes
const defaultClasses = "peer h-4 w-4 shrink-0 rounded-sm border border-white/20 bg-white/5 ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/20 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 appearance-none cursor-pointer checked:bg-primary checked:border-primary transition-all relative";

const finalClass = className ? `${defaultClasses} ${className}` : defaultClasses;
---

<!-- Checkbox with native styling -->
<div class="inline-flex items-center relative">
  <input
    type="checkbox"
    id={checkboxId}
    class={finalClass}
    name={name}
    value={value}
    checked={checked}
    disabled={disabled}
    required={required}
    autofocus={autofocus}
    form={form}
    {...rest}
  />

  <!-- Check icon (visible when checked via CSS peer selector) -->
  <svg
    class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-3 h-3 text-white opacity-0 peer-checked:opacity-100 transition-opacity"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polyline points="20 6 9 17 4 12"></polyline>
  </svg>
</div>

<style>
  /* Checkbox custom styling */
  input[type="checkbox"] {
    position: relative;
  }

  input[type="checkbox"]:checked {
    background-color: hsl(var(--primary) / 1);
    border-color: hsl(var(--primary) / 1);
  }

  input[type="checkbox"]:hover:not(:disabled) {
    border-color: hsl(var(--primary) / 0.5);
  }

  input[type="checkbox"]:focus-visible {
    outline: 2px solid hsl(var(--ring) / 0.5);
    outline-offset: 2px;
  }

  input[type="checkbox"]:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  /* Check icon visibility */
  .peer:checked ~ svg {
    opacity: 1;
  }
</style>
