---
/**
 * Alert Component - Static variant for Astro
 * Displays important information to users
 */

interface AlertProps {
  variant?: 'default' | 'destructive';
  class?: string;
  [key: string]: any;
}

const { variant = 'default', class: className, ...props } = Astro.props;

// Variant classes - matching the CVA patterns from original
const baseClasses = "relative w-full rounded-lg border px-4 py-3 text-sm grid has-[>svg]:grid-cols-[calc(var(--spacing)*4)_1fr] grid-cols-[0_1fr] has-[>svg]:gap-x-3 gap-y-0.5 items-start [&>svg]:size-4 [&>svg]:translate-y-0.5 [&>svg]:text-current";

const variantClasses: Record<string, string> = {
  default: "bg-card text-card-foreground",
  destructive: "text-destructive bg-card [&>svg]:text-current *:data-[slot=alert-description]:text-destructive/90",
};

const classes = `${baseClasses} ${variantClasses[variant]} ${className || ''}`;
---

<div
  data-slot="alert"
  role="alert"
  class={classes}
  {...props}
>
  <slot />
</div>
