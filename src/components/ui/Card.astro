---
/**
 * Card Component
 * A flexible card container with header, content, and footer sections
 */
interface CardProps {
	class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<div
	data-slot="card"
	class:list={[
		"bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm",
		className
	]}
	{...rest}
>
	<slot />
</div>
