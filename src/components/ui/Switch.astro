---
/**
 * Switch Component - Astro version
 * Accessible toggle switch component with visual state management
 * Uses native checkbox with CSS-based styling
 */
interface SwitchProps {
  checked?: boolean;
  disabled?: boolean;
  required?: boolean;
  name?: string;
  value?: string;
  id?: string;
  class?: string;
  autofocus?: boolean;
  form?: string;
}

const {
  checked = false,
  disabled = false,
  required = false,
  id,
  name,
  value,
  class: className,
  autofocus,
  form,
  ...rest
} = Astro.props;

// Generate unique ID if not provided
const switchId = id || `switch-${Math.random().toString(36).substring(2, 9)}`;

// Base classes for the switch label
const defaultClasses = "peer inline-flex h-[1.15rem] w-8 shrink-0 cursor-pointer items-center rounded-full border-2 border-transparent transition-all duration-200 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/20 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 relative";

const finalClass = className ? `${defaultClasses} ${className}` : defaultClasses;
---

<!-- Switch with native checkbox input -->
<label for={switchId} class={finalClass}>
  <!-- Hidden checkbox for form submission and state -->
  <input
    type="checkbox"
    id={switchId}
    class="sr-only"
    name={name}
    value={value}
    checked={checked}
    disabled={disabled}
    required={required}
    autofocus={autofocus}
    form={form}
    {...rest}
  />

  <!-- Switch track (background) -->
  <span
    class="block h-full w-full rounded-full bg-input transition-colors duration-200 peer-checked:bg-primary peer-focus-visible:ring-2 peer-focus-visible:ring-white/20"
    aria-hidden="true"
  >
    <!-- Switch thumb (sliding circle) -->
    <span class="block h-4 w-4 rounded-full bg-background shadow-md transform transition-transform duration-200 translate-x-0 peer-checked:translate-x-[calc(100%-2px)] pointer-events-none absolute top-1/2 -translate-y-1/2 left-0"></span>
  </span>
</label>

<style>
  /* Switch track styling */
  .peer:not(:checked) ~ span:first-of-type {
    background-color: hsl(var(--input) / 1);
  }

  .peer:checked ~ span:first-of-type {
    background-color: hsl(var(--primary) / 1);
  }

  /* Switch thumb positioning */
  .peer:not(:checked) ~ span:first-of-type > span {
    transform: translate(0, -50%);
  }

  .peer:checked ~ span:first-of-type > span {
    transform: translate(calc(100% - 4px), -50%);
  }

  /* Focus visible styling */
  .peer:focus-visible ~ span:first-of-type {
    box-shadow: 0 0 0 2px hsl(var(--background) / 1),
                0 0 0 4px hsl(var(--ring) / 0.5);
  }

  /* Disabled state */
  .peer:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  /* Screen reader only class */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
