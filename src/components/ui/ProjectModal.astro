---
/**
 * ProjectModal - Accessible modal component using Alpine.js
 * Features:
 * - Focus trap (keeps focus within modal when open)
 * - Escape key to close
 * - Click outside to close
 * - Backdrop overlay
 * - Smooth animations
 * - ARIA accessibility
 * - Body scroll lock when open
 */

interface ProjectModalProps {
  project: {
    id: string;
    name: string;
    description: string;
    image?: string;
    images?: Array<{ url: string; alt?: string }>;
    link?: string;
    github?: string;
    projectInitiated: string;
    projectCompleted?: string;
    isCompleted: boolean;
    isFeatured: boolean;
    projectCategories?: Array<{ category: { name: string } }>;
    technologies?: Array<{ technology: { name: string } }>;
  };
}

const { project } = Astro.props;
---

<div
  x-data="{ isOpen: false, currentImageIndex: 0, projectId: '{project.id}' }"
  x-show="isOpen"
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-200"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  @open-modal.window="$event.detail.projectId === projectId && (isOpen = true, currentImageIndex = 0, document.body.style.overflow = 'hidden')"
  @keydown.escape="isOpen = false; document.body.style.overflow = ''"
  @click.self="isOpen = false; document.body.style.overflow = ''"
  class="fixed inset-0 z-50"
  style="display: none;"
  role="dialog"
  aria-modal="true"
  :aria-hidden="!isOpen"
>
  <!-- Backdrop -->
  <div
    class="absolute inset-0 bg-black/60 backdrop-blur-sm"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click="handleBackdropClick($event)"
    aria-hidden="true"
  ></div>

  <!-- Modal Container -->
  <div class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6">
    <div
      class="relative w-full max-w-4xl bg-neutral-900 rounded-2xl border border-white/10 max-h-[85vh] overflow-y-auto p-4 sm:p-6 my-4 sm:my-0"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 scale-95 translate-y-5"
      x-transition:enter-end="opacity-100 scale-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 scale-100 translate-y-0"
      x-transition:leave-end="opacity-0 scale-95 translate-y-5"
    >
      <!-- Close button -->
      <button
        x-ref="closeButton"
        @click="close()"
        class="absolute right-4 top-4 p-2 rounded-lg hover:bg-white/10 transition-colors z-10 focus:outline-none focus:ring-2 focus:ring-white/50"
        aria-label="Close modal"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <!-- Content -->
      <div class="space-y-6">
        <!-- Header -->
        <div class="space-y-2 pr-8">
          <h2 id="project-title" class="text-2xl font-bold text-white">
            {project.name}
          </h2>
          <div class="flex flex-wrap gap-2">
            {
              project.projectCategories?.map((pc) => pc.category.name).map((category, index) => (
                <span
                  key={index}
                  class="px-2 py-1 text-xs rounded-full bg-white/10 text-white/70"
                >
                  {category}
                </span>
              ))
            }
          </div>
        </div>

        <!-- Image Carousel -->
        {
          (project.image || project.images?.length > 0) && (
            <div class="relative w-full h-80 rounded-xl overflow-hidden">
              <div
                x-ref="images"
                class="w-full h-full relative"
              >
                {
                  // If there are multiple images, show carousel; otherwise show single image
                  project.images && project.images.length > 1 ? (
                    <div class="w-full h-full relative">
                      {
                        project.images.map((img, index) => (
                          <img
                            src={img.url}
                            alt={img.alt || project.name}
                            class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-300 ${
                              index === 0 ? 'opacity-100' : 'opacity-0'
                            }`}
                            style={`display: ${index === 0 ? 'block' : 'none'};`}
                            data-index={index}
                          />
                        ))
                      }

                      <!-- Navigation buttons -->
                      <button
                        @click="prevImage()"
                        class="absolute left-2 top-1/2 -translate-y-1/2 p-2 rounded-full bg-black/50 hover:bg-black/70 transition-colors focus:outline-none focus:ring-2 focus:ring-white/50"
                        aria-label="Previous image"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                      </button>
                      <button
                        @click="nextImage()"
                        class="absolute right-2 top-1/2 -translate-y-1/2 p-2 rounded-full bg-black/50 hover:bg-black/70 transition-colors focus:outline-none focus:ring-2 focus:ring-white/50"
                        aria-label="Next image"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      </button>

                      <!-- Dots indicator -->
                      <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2">
                        {
                          project.images.map((_, index) => (
                            <button
                              class={`w-2 h-2 rounded-full transition-colors ${
                                index === 0 ? 'bg-white' : 'bg-white/50'
                              }`}
                              aria-label={`Go to image ${index + 1}`}
                              data-dot-index={index}
                            ></button>
                          ))
                        }
                      </div>
                    </div>
                  ) : (
                    <img
                      src={project.image || project.images?.[0]?.url}
                      alt={project.name}
                      class="absolute inset-0 w-full h-full object-cover"
                    />
                  )
                }
              </div>
            </div>
          )
        }

        <!-- Description -->
        <div class="prose prose-invert max-w-none">
          <p id="project-description" class="text-white/80 leading-relaxed">
            {project.description}
          </p>
        </div>

        <!-- Tech Stack -->
        <div class="space-y-2">
          <h3 class="text-lg font-semibold text-white">
            Tech Stack
          </h3>
          <div class="flex flex-wrap gap-2">
            {
              project.technologies?.map((pt) => pt.technology.name).map((tech, index) => (
                <span
                  key={index}
                  class="px-3 py-1 rounded-full bg-white/10 text-white/70 text-sm"
                >
                  {tech}
                </span>
              ))
            }
          </div>
        </div>

        <!-- Project Details -->
        <div class="grid grid-cols-2 gap-4 text-sm text-white/70">
          <div>
            <p>
              Started:{" "}
              {new Date(project.projectInitiated).toLocaleDateString()}
            </p>
            {
              project.projectCompleted && (
                <p>
                  Completed:{" "}
                  {new Date(project.projectCompleted).toLocaleDateString()}
                </p>
              )
            }
          </div>
          <div>
            <p>
              Status:{" "}
              {project.isCompleted ? "Completed" : "In Progress"}
            </p>
            {
              project.isFeatured && (
                <p class="text-blue-400">Featured Project</p>
              )
            }
          </div>
        </div>

        <!-- Actions -->
        <div class="flex gap-4 pt-4">
          {
            project.link && (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-white font-medium transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-white/50"
              >
                View Project
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            )
          }
          {
            project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-white font-medium transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-white/50"
              >
                View Code
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Ensure backdrop and modal layer correctly */
  [role="dialog"] > div:first-child {
    z-index: 1;
  }
  [role="dialog"] > div:last-child {
    z-index: 2;
  }
</style>
