---
/**
 * CardFooter Component
 * Footer section for cards with actions or metadata
 */
interface CardFooterProps {
	class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<div
	data-slot="card-footer"
	class:list={["flex items-center px-6 [.border-t]:pt-6", className]}
	{...rest}
>
	<slot />
</div>
