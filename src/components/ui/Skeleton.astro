---
/**
 * Skeleton Component
 * A placeholder loading state with a pulsing animation
 *
 * @param {string} className - Additional CSS classes
 */
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div
  data-slot="skeleton"
  class:list={['bg-accent animate-pulse rounded-md', className]}
/>
