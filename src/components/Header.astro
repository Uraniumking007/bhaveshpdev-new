---
const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog', isRoutePrefix: true },
];

const isActive = (href: string, isRoutePrefix = false) => {
  if (isRoutePrefix) {
    return currentPath.startsWith(href) && currentPath.length > href.length;
  }
  return currentPath === href;
};
---

<header class="border-b border-zinc-200 bg-white sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <a
        href="/"
        class="text-xl font-bold text-zinc-900 hover:text-zinc-700"
      >
        Bhavesh Patil
      </a>

      <!-- Desktop navigation -->
      <nav class="hidden md:flex space-x-8 items-center">
        {navItems.map(item => (
          <a
            href={item.href}
            class={`text-sm font-medium transition-colors hover:text-zinc-900 ${
              isActive(item.href, item.isRoutePrefix)
                ? 'text-zinc-900 font-semibold'
                : 'text-zinc-600'
            }`}
          >
            {item.label}
          </a>
        ))}

        <!-- Resume secondary link -->
        <a
          href="/resume"
          class={`text-sm font-medium transition-colors hover:text-zinc-900 ml-4 flex items-center gap-1 ${
            isActive('/resume', false)
              ? 'text-zinc-900 font-semibold'
              : 'text-zinc-600'
          }`}
          aria-label="View Resume"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9 5-9 5 9 5zm0-12v4l4-4 4 4H3l4 4 4z" />
          </svg>
          Resume
        </a>

        <!-- Contact CTA -->
        <a
          href="/contact"
          class={`bg-zinc-900 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-zinc-800 transition-colors ml-4 ${
            isActive('/contact', false)
              ? 'bg-zinc-800'
              : ''
          }`}
        >
          Contact
        </a>
      </nav>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        class="md:hidden p-2 rounded-md text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100"
        aria-label="Open menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile navigation -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="space-y-1 pt-2">
        {navItems.map(item => (
          <a
            href={item.href}
            class={`block px-3 py-2 text-base font-medium rounded-md transition-colors ${
              isActive(item.href, item.isRoutePrefix)
                ? 'bg-zinc-100 text-zinc-900'
                : 'text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900'
            }`}
          >
            {item.label}
          </a>
        ))}

        <!-- Resume secondary link -->
        <a
          href="/resume"
          class={`block px-3 py-2 text-base font-medium rounded-md transition-colors flex items-center gap-2 ${
            isActive('/resume', false)
              ? 'bg-zinc-100 text-zinc-900'
              : 'text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900'
          }`}
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9 5-9 5 9 5zm0-12v4l4-4 4 4H3l4 4 4z" />
          </svg>
          Resume
        </a>

        <!-- Contact CTA -->
        <a
          href="/contact"
          class={`block px-3 py-2 text-base font-medium rounded-md bg-zinc-900 text-white hover:bg-zinc-800 transition-colors ${
            isActive('/contact', false)
              ? 'bg-zinc-800'
              : ''
          }`}
        >
          Contact
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuButton && mobileMenu) {
    mobileMenuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
