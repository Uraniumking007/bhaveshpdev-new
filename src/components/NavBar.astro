---
/**
 * NavBar Component - Enhanced Astro Version with Alpine.js
 *
 * Features:
 * - Mobile responsive hamburger menu with animation
 * - Desktop navigation menu
 * - Smooth transitions and hover effects
 * - Magic border buttons with spinning gradient
 * - Alpine.js for state management
 */

interface Props {
  currentPath?: string;
}

const normalizePath = (path: string) =>
  path === '/' ? '/' : path.replace(/\/+$/, '');

const rawCurrentPath = (Astro.props as Props).currentPath ?? Astro.url.pathname;
const currentPath = normalizePath(rawCurrentPath);

const menuItems = [
  { label: 'Home', path: '/' },
  { label: 'Projects', path: '/projects' },
  { label: 'Certifications', path: '/certifications' },
];
---

<nav
  class="absolute top-8 right-8 z-50"
  x-data="{ isOpen: false }"
>
  <!-- Mobile Menu Toggle Button with Animated Hamburger -->
  <button
    @click="isOpen = !isOpen"
    class="lg:hidden w-8 h-8 flex flex-col justify-around z-50 relative bg-transparent border-none cursor-pointer p-0"
    aria-label="Toggle menu"
    aria-expanded="false"
    :aria-expanded="isOpen"
  >
    <!-- Hamburger Icon Lines with Animation -->
    <span
      class="block w-6 h-0.5 bg-white transition-all duration-300 origin-center"
      :class="isOpen ? 'rotate-45 translate-y-1.5' : 'rotate-0 translate-y-0'"
    ></span>
    <span
      class="block w-6 h-0.5 bg-white transition-all duration-300"
      :class="isOpen ? 'opacity-0' : 'opacity-100'"
    ></span>
    <span
      class="block w-6 h-0.5 bg-white transition-all duration-300 origin-center"
      :class="isOpen ? '-rotate-45 -translate-y-1.5' : 'rotate-0 translate-y-0'"
    ></span>
  </button>

  <!-- Mobile Menu with Alpine.js Transitions -->
  <ul
    x-show="isOpen"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 -translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-4"
    class="flex lg:hidden gap-2 flex-col w-28 absolute -top-4 right-8 list-none m-0 p-0"
    style="display: none;"
  >
    {menuItems.map((item) => (
      <li>
        <a
          href={item.path}
          class:list={["magic-border-button block", { active: normalizePath(item.path) === currentPath }]}
          @click="isOpen = false"
        >
          <span>{item.label}</span>
        </a>
      </li>
    ))}
  </ul>

  <!-- Desktop Menu -->
  <ul class="hidden lg:flex gap-4 w-fit absolute top-4 right-8 list-none m-0 p-0">
    {menuItems.slice(0, -1).map((item) => (
      <li class="w-28 h-12">
        <a
          href={item.path}
          class:list={["magic-border-button block", { active: normalizePath(item.path) === currentPath }]}
        >
          <span>{item.label}</span>
        </a>
      </li>
    ))}
    <li class="w-28 h-12">
      <a
        href="/resume"
        class="relative w-full inline-flex md:h-12 h-10 drop-shadow-2xl overflow-hidden rounded-full p-[1px] focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2 focus:ring-offset-slate-50 magic-border-button-resume"
      >
        <span class="absolute inset-[-1000%] animate-[spin_2s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,#E2CBFF_0%,#393BB2_50%,#E2CBFF_100%)]"></span>
        <span class="inline-flex h-full w-full cursor-pointer items-center justify-center rounded-full bg-slate-950 px-3 py-1 text-sm font-medium text-white backdrop-blur-3xl">
          Resume
        </span>
      </a>
    </li>
  </ul>
</nav>

<style>
  /* Magic Border Button Styles - plain CSS for Tailwind v4 @apply compatibility */
  .magic-border-button {
    position: relative;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    filter: drop-shadow(0 25px 25px rgb(0 0 0 / 0.15));
    overflow: hidden;
    border-radius: 9999px;
    padding: 1px;
    text-decoration: none;
  }
  .magic-border-button:focus {
    outline: 2px solid rgb(148 163 184);
    outline-offset: 2px;
  }
  @media (min-width: 768px) {
    .magic-border-button {
      height: 3rem;
    }
  }

  .magic-border-button::before {
    content: '';
    position: absolute;
    inset: -1000%;
    animation: spin 2s linear infinite;
    background: conic-gradient(from 90deg at 50% 50%, #E2CBFF 0%, #393BB2 50%, #E2CBFF 100%);
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .magic-border-button span {
    display: inline-flex;
    height: 100%;
    width: 100%;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background-color: rgb(2 6 23);
    padding: 0.25rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: white;
    position: relative;
    z-index: 1;
  }

  .magic-border-button.active {
    opacity: 1;
  }

  .magic-border-button.active span {
    background-color: rgb(30 41 59);
  }

  /* Resume button specific styles */
  .magic-border-button-resume {
    transition: all 0.3s ease;
  }

  .magic-border-button-resume:hover {
    transform: scale(1.05);
  }

  /* Mobile menu animation */
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  [x-show] > li {
    animation: slideIn 0.3s ease-out;
  }
</style>

<script>
  // Add Alpine.js check
  if (typeof Alpine === 'undefined') {
    console.warn('Alpine.js is not loaded. Please add it to your layout:');
    console.warn('npm install @astrojs/alpinejs');
    console.warn('Then add it to astro.config.mjs');
  }
</script>
