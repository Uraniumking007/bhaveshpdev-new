---
import '@/styles/global.css';
import { ClientRouter, slide } from 'astro:transitions';
 
interface Props {
   title: string;
 }

const { title } = Astro.props;
---
 
<!doctype html>
<html lang="en" transition:name="root" transition:animate={slide({ duration: '0.5s' })}>
   <head>
     <meta charset="UTF-8" />
     <meta name="description" content="Bhavesh Patil - Software Developer Portfolio" />
     <meta name="viewport" content="width=device-width" />
     <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
   </head>
   <body>
    <slot />
   </body>
</html>
