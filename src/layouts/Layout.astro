---
import "../pages/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bhavesh Patil Dev | Full Stack Developer",
  description = "Portfolio and blog of Bhavesh Patil - Full Stack Developer specializing in React, Next.js, and modern web technologies.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
