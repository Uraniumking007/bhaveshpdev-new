---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout title="Contact - Bhavesh Patil">
  <Header currentPath="/contact" />
  <main class="min-h-screen py-20 px-4">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-4xl font-bold text-zinc-900 mb-4">Get in Touch</h1>
      <p class="text-lg text-zinc-600 mb-12">
        Have a question or want to work together? Drop me a message!
      </p>

      <form class="bg-white border border-zinc-200 rounded-lg p-8" method="POST" action="/api/contact">
        <div class="mb-6">
          <label for="name" class="block text-sm font-medium text-zinc-900 mb-2">
            Name
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full px-4 py-2 border border-zinc-300 rounded-md focus:ring-2 focus:ring-zinc-900 focus:border-transparent"
            placeholder="Your name"
          />
        </div>

        <div class="mb-6">
          <label for="email" class="block text-sm font-medium text-zinc-900 mb-2">
            Email
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-2 border border-zinc-300 rounded-md focus:ring-2 focus:ring-zinc-900 focus:border-transparent"
            placeholder="your.email@example.com"
          />
        </div>

        <div class="mb-6">
          <label for="subject" class="block text-sm font-medium text-zinc-900 mb-2">
            Subject
          </label>
          <input
            type="text"
            id="subject"
            name="subject"
            required
            class="w-full px-4 py-2 border border-zinc-300 rounded-md focus:ring-2 focus:ring-zinc-900 focus:border-transparent"
            placeholder="What's this about?"
          />
        </div>

        <div class="mb-6">
          <label for="message" class="block text-sm font-medium text-zinc-900 mb-2">
            Message
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="6"
            class="w-full px-4 py-2 border border-zinc-300 rounded-md focus:ring-2 focus:ring-zinc-900 focus:border-transparent"
            placeholder="Your message..."
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full px-6 py-3 bg-zinc-900 text-white rounded-lg font-medium hover:bg-zinc-800 transition-colors"
        >
          Send Message
        </button>
      </form>

      <div class="mt-12 text-center">
        <p class="text-zinc-600 mb-4">Or reach me directly</p>
        <div class="flex flex-wrap justify-center gap-6">
          <a
            href="mailto:bhavesh@example.com"
            class="text-zinc-900 hover:text-zinc-700"
          >
            bhavesh@example.com
          </a>
          <span class="text-zinc-300">•</span>
          <a
            href="https://github.com/UraniumKing007"
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-900 hover:text-zinc-700"
          >
            GitHub
          </a>
          <span class="text-zinc-300">•</span>
          <a
            href="https://linkedin.com/in/bhaveshpatil"
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-900 hover:text-zinc-700"
          >
            LinkedIn
          </a>
          <span class="text-zinc-300">•</span>
          <a
            href="https://twitter.com/UraniumKing007"
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-900 hover:text-zinc-700"
          >
            Twitter
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
