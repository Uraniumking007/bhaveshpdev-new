---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

export const prerender = false;
---

<BaseLayout title="Login - Bhavesh Patel">
  <Header currentPath="/admin/login" />
  <main class="min-h-screen py-20 px-4">
    <div class="max-w-md mx-auto">
      <div class="bg-white border border-zinc-200 rounded-lg p-8">
        <h1 class="text-2xl font-bold text-zinc-900 mb-6 text-center">
          Admin Login
        </h1>
        <p class="text-zinc-600 text-center mb-6">
          Sign in to access the admin dashboard
        </p>

        <form class="space-y-4" action="/api/auth/login" method="POST">
          <div>
            <label for="username" class="block text-sm font-medium text-zinc-900 mb-2">
              GitHub Username
            </label>
            <input
              type="text"
              id="username"
              name="username"
              required
              class="w-full px-4 py-2 border border-zinc-300 rounded-md focus:ring-2 focus:ring-zinc-900 focus:border-transparent"
              placeholder="Your GitHub username"
            />
          </div>

          <button
            type="submit"
            class="w-full px-4 py-2 bg-zinc-900 text-white rounded-md font-medium hover:bg-zinc-800 transition-colors"
          >
            Sign in with GitHub
          </button>
        </form>

        <p class="text-sm text-zinc-500 text-center mt-4">
          Currently using Better Auth with GitHub OAuth
        </p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
