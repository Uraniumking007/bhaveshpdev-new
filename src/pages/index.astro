---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { motion } from "framer-motion";
---

<BaseLayout title="Home - Bhavesh Patil">
  <Header currentPath="/" />
  <main class="min-h-screen">
    <section class="bg-gradient-to-b from-zinc-50 to-white py-20 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl font-bold text-zinc-900 mb-6">
          Hi, I'm <span class="text-zinc-600">Bhavesh Patil</span>
        </h1>
        <p class="text-xl md:text-2xl text-zinc-600 mb-6">
          Software Developer specializing in Full-Stack Development
        </p>
        <p class="text-lg text-zinc-600 leading-relaxed mb-8 max-w-3xl mx-auto">
          I'm a passionate software developer with expertise in full-stack
          development. I love building clean, efficient, and user-friendly
          applications that solve real-world problems.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/projects"
            class="inline-flex items-center justify-center px-6 py-3 bg-zinc-900 text-white rounded-lg font-medium hover:bg-zinc-800 transition-colors"
          >
            View Projects
          </a>
          <a
            href="/about"
            class="inline-flex items-center justify-center px-6 py-3 bg-white border border-zinc-300 text-zinc-900 rounded-lg font-medium hover:bg-zinc-50 transition-colors"
          >
            Learn More
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-6 py-3 bg-white border border-zinc-300 text-zinc-900 rounded-lg font-medium hover:bg-zinc-50 transition-colors"
          >
            Get in Touch
          </a>
        </div>
      </div>
    </section>

    <section class="py-20 px-4 bg-zinc-50">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-zinc-900 mb-6 text-center">
          Featured Projects
        </h2>
        <div class="grid md:grid-cols-2 gap-6">
          <motion.div
            className="bg-white border border-zinc-200 rounded-lg p-6 hover:shadow-xl transition-shadow"
            whileHover={{ scale: 1.03, y: -4 }}
            transition={{ type: "spring", stiffness: 300 }}
          >
            <div
              class="aspect-video bg-zinc-100 flex items-center justify-center"
            >
              <span class="text-zinc-400">Project Screenshot</span>
            </div>
            <h3 class="text-lg font-semibold text-zinc-900 mb-2">
              Portfolio Website
            </h3>
            <p class="text-zinc-600 mb-4">
              Modern portfolio and blog built with Astro, TypeScript, and
              Tailwind CSS.
            </p>
            <a
              href="/projects"
              class="text-sm font-medium text-zinc-900 hover:text-zinc-700"
            >
              View Details →
            </a>
          </motion.div>

          <motion.div
            className="bg-white border border-zinc-200 rounded-lg p-6 hover:shadow-xl transition-shadow"
            whileHover={{ scale: 1.03, y: -4 }}
            transition={{ type: "spring", stiffness: 300 }}
          >
            <div
              class="aspect-video bg-zinc-100 flex items-center justify-center"
            >
              <span class="text-zinc-400">Project Screenshot</span>
            </div>
            <h3 class="text-lg font-semibold text-zinc-900 mb-2">
              Blog Platform
            </h3>
            <p class="text-zinc-600 mb-4">
              Full-stack blog with authentication, rich text editor, and
              scheduled publishing.
            </p>
            <a
              href="/blog"
              class="text-sm font-medium text-zinc-900 hover:text-zinc-700"
            >
              Read Posts →
            </a>
          </motion.div>
        </div>

        <div
          class="bg-white border border-zinc-200 rounded-lg p-6 hover:shadow-lg transition-shadow"
        >
          <h3 class="text-lg font-semibold text-zinc-900 mb-2">
            Blog Platform
          </h3>
          <p class="text-zinc-600 mb-4">
            Full-featured blog with authentication, rich text editor, and
            scheduled publishing.
          </p>
          <a
            href="/blog"
            class="text-sm font-medium text-zinc-900 hover:text-zinc-700"
          >
            Read Posts →
          </a>
        </div>
      </div>
    </section>
  </main>

  <section id="experience" class="scroll-mt-20 py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-zinc-900 mb-6 text-center">
        Experience
      </h2>
      <div class="space-y-8">
        <div class="border-l-2 border-zinc-200 pl-6 relative">
          <div class="absolute -left-2 top-0 h-4 w-4 bg-zinc-900 rounded-full">
          </div>
          <h3 class="text-xl font-semibold text-zinc-900 mb-2">
            Software Developer
          </h3>
          <p class="text-zinc-600 mb-2">Company Name • 2022 - Present</p>
          <ul class="space-y-2 text-zinc-600 ml-4">
            <li>• Developed and maintained full-stack web applications</li>
            <li>
              • Collaborated with cross-functional teams to deliver features
            </li>
            <li>• Implemented responsive UIs using modern frameworks</li>
            <li>• Optimized database queries and API performance</li>
          </ul>
        </div>

        <div class="border-l-2 border-zinc-200 pl-6 relative">
          <div class="absolute -left-2 top-0 h-4 w-4 bg-zinc-900 rounded-full">
          </div>
          <h3 class="text-xl font-semibold text-zinc-900 mb-2">
            Junior Developer
          </h3>
          <p class="text-zinc-600 mb-2">Previous Company • 2020 - 2022</p>
          <ul class="space-y-2 text-zinc-600 ml-4">
            <li>• Built web applications using JavaScript and frameworks</li>
            <li>• Fixed bugs and improved existing codebases</li>
            <li>• Participated in code reviews and team meetings</li>
            <li>
              • Learned and applied best practices in software development
            </li>
          </ul>
        </div>

        <div class="border-l-2 border-zinc-200 pl-6 relative">
          <div class="absolute -left-2 top-0 h-4 w-4 bg-zinc-900 rounded-full">
          </div>
          <h3 class="text-xl font-semibold text-zinc-900 mb-2">Education</h3>
          <p class="text-zinc-600 mb-2">University Name • 2016 - 2020</p>
          <p class="text-zinc-600">
            Bachelor's degree in Computer Science or related field
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="skills" class="py-20 px-4 bg-zinc-50">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-zinc-900 mb-6 text-center">
        Skills & Stack
      </h2>
      <p class="text-lg text-zinc-600 mb-12 text-center">
        Technologies and tools I work with
      </p>

      <div class="space-y-12">
        <section>
          <h3 class="text-2xl font-semibold text-zinc-900 mb-6">
            Frontend Development
          </h3>
          <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            {
              [
                "React",
                "TypeScript",
                "JavaScript",
                "Tailwind CSS",
                "Astro",
                "Next.js",
                "HTML5",
                "CSS3",
              ].map((skill) => (
                <div class="bg-white border border-zinc-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                  <span class="text-zinc-900 font-medium">{skill}</span>
                </div>
              ))
            }
          </div>
        </section>

        <section>
          <h3 class="text-2xl font-semibold text-zinc-900 mb-6">
            Backend Development
          </h3>
          <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            {
              [
                "Node.js",
                "Python",
                "Express",
                "FastAPI",
                "PostgreSQL",
                "MongoDB",
                "Redis",
                "GraphQL",
              ].map((skill) => (
                <div class="bg-white border border-zinc-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                  <span class="text-zinc-900 font-medium">{skill}</span>
                </div>
              ))
            }
          </div>
        </section>

        <section>
          <h3 class="text-2xl font-semibold text-zinc-900 mb-6">
            DevOps & Tools
          </h3>
          <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            {
              [
                "Git",
                "Docker",
                "Kubernetes",
                "AWS",
                "Vercel",
                "CI/CD",
                "Linux",
                "Nginx",
              ].map((skill) => (
                <div class="bg-white border border-zinc-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                  <span class="text-zinc-900 font-medium">{skill}</span>
                </div>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </section>

  <section id="testimonials" class="py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-zinc-900 mb-6 text-center">
        Testimonials
      </h2>
      <p class="text-lg text-zinc-600 mb-12 text-center">
        What people say about working with me
      </p>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white border border-zinc-200 rounded-lg p-6">
          <p class="text-zinc-600 mb-4 italic">
            "Bhavesh is an exceptional developer who consistently delivers
            high-quality work. His attention to detail and problem-solving
            skills are outstanding."
          </p>
          <div class="flex items-center">
            <div
              class="h-12 w-12 bg-zinc-200 rounded-full flex items-center justify-center mr-4"
            >
              <span class="text-zinc-600">initials</span>
            </div>
            <div>
              <p class="font-semibold text-zinc-900">Colleague Name</p>
              <p class="text-sm text-zinc-600">Title at Company</p>
            </div>
          </div>
        </div>

        <div class="bg-white border border-zinc-200 rounded-lg p-6">
          <p class="text-zinc-600 mb-4 italic">
            "Working with Bhavesh was a pleasure. He's knowledgeable,
            collaborative, and always meets deadlines."
          </p>
          <div class="flex items-center">
            <div
              class="h-12 w-12 bg-zinc-200 rounded-full flex items-center justify-center mr-4"
            >
              <span class="text-zinc-600">initials</span>
            </div>
            <div>
              <p class="font-semibold text-zinc-900">Colleague Name</p>
              <p class="text-sm text-zinc-600">Title at Company</p>
            </div>
          </div>
        </div>
      </div>

      <p class="text-center text-zinc-600 italic mt-12">
        More testimonials coming soon!
      </p>
    </div>
  </section>

  <section id="speaking" class="py-20 px-4 bg-zinc-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-zinc-900 mb-6 text-center">
        Speaking & Writing
      </h2>
      <p class="text-lg text-zinc-600 mb-12 text-center">
        Talks, articles, and other content I've created
      </p>

      <div class="space-y-12">
        <section>
          <h3 class="text-2xl font-semibold text-zinc-900 mb-6">
            Conference Talks
          </h3>
          <p class="text-zinc-600 italic">
            Coming soon - I'm working on my first conference presentation!
          </p>
        </section>

        <section>
          <h3 class="text-2xl font-semibold text-zinc-900 mb-6">
            Blog Articles
          </h3>
          <p class="text-zinc-600 italic">
            Check out my <a
              href="/blog"
              class="text-zinc-900 font-medium hover:underline">blog</a
            > for my latest articles
          </p>
        </section>
      </div>
    </div>
  </section>

  <section id="contact" class="py-20 px-4">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-zinc-900 mb-6">Get in Touch</h2>
      <p class="text-lg text-zinc-600 mb-12">
        Have a question or want to work together? Drop me a message!
      </p>

      <a
        href="/contact"
        class="inline-flex items-center justify-center px-8 py-4 bg-zinc-900 text-white rounded-lg font-medium hover:bg-zinc-800 transition-colors"
      >
        Contact Me
      </a>
    </div>
  </section>
</BaseLayout>
<Footer />
