---
/**
 * Project Details Page - Dynamic route for individual projects
 * Uses Astro View Transitions for smooth navigation
 */

import { getStaticData } from "@/lib/data";
import Layout from "@/layouts/Layout.astro";

export const prerender = true;

export async function getStaticPaths() {
  const data = await getStaticData();
  return data.projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;

// Get related data
const techNames = project.technologies?.map((pt) => pt.technology?.name || "").filter(Boolean) || [];
const categoryNames = project.projectCategories?.map((pc) => pc.category?.name || "").filter(Boolean) || [];
---

<Layout title={`${project.name} - Project Details`}>
  <div
    class="min-h-screen bg-[var(--background)] text-[var(--foreground)] py-12 px-4 sm:px-6 lg:px-8"
  >
    <div class="max-w-6xl mx-auto">
      <!-- Back Navigation -->
      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-[var(--muted-foreground)] hover:text-primary transition-colors mb-8"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Back to Projects</span>
      </a>

      <!-- Main Content Grid -->
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
        <!-- Left Column - Images -->
        <div class="space-y-6">
          <!-- Main Image with transition -->
          <div
            class="relative aspect-video rounded-xl overflow-hidden shadow-2xl"
            transition:name={`project-image-${project.id}`}
          >
            <img
              src={project.image || "/placeholder-project.png"}
              alt={project.name}
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>

          <!-- Additional Images Gallery -->
          {
            project.images && project.images.length > 1 && (
              <div class="grid grid-cols-2 gap-4">
                {project.images.slice(1).map((img: any, index: number) => (
                  <div
                    key={img.url || index}
                    class="aspect-video rounded-lg overflow-hidden shadow-lg"
                  >
                    <img
                      src={img.url}
                      alt={img.alt || `${project.name} screenshot ${index + 2}`}
                      class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
            )
          }
        </div>

        <!-- Right Column - Details -->
        <div class="space-y-6">
          <!-- Title -->
          <h1
            class="text-4xl sm:text-5xl font-bold text-[var(--foreground)] tracking-tight"
            transition:name={`project-title-${project.id}`}
          >
            {project.name}
          </h1>

          <!-- Description -->
          <p class="text-lg text-[var(--muted-foreground)] leading-relaxed">
            {project.description}
          </p>

          <!-- Status Badge -->
          <div class="flex items-center gap-3">
            <span
              class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${
                project.isCompleted
                  ? "bg-green-500/10 text-green-500 border border-green-500/20"
                  : "bg-yellow-500/10 text-yellow-500 border border-yellow-500/20"
              }`}
            >
              {project.isCompleted ? "Completed" : "In Progress"}
            </span>
            {
              project.isFeatured && (
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary/10 text-primary border border-primary/20">
                  Featured
                </span>
              )
            }
          </div>

          <!-- Dates -->
          <div class="flex items-center gap-4 text-sm text-[var(--muted-foreground)]">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>
                Started: {new Date(project.projectInitiated).toLocaleDateString("en-US", { year: "numeric", month: "long" })}
              </span>
            </div>
            {
              project.projectCompleted && (
                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>
                    Completed: {new Date(project.projectCompleted).toLocaleDateString("en-US", { year: "numeric", month: "long" })}
                  </span>
                </div>
              )
            }
          </div>

          <!-- Categories -->
          {
            categoryNames.length > 0 && (
              <div>
                <h3 class="text-sm font-semibold text-[var(--foreground)] mb-3">Categories</h3>
                <div class="flex flex-wrap gap-2">
                  {categoryNames.map((category: string) => (
                    <span class="inline-flex items-center px-3 py-1 rounded-lg bg-secondary/50 text-secondary-foreground text-sm border border-secondary/200">
                      {category}
                    </span>
                  ))}
                </div>
              </div>
            )
          }

          <!-- Technologies -->
          {
            techNames.length > 0 && (
              <div>
                <h3 class="text-sm font-semibold text-[var(--foreground)] mb-3">Technologies Used</h3>
                <div class="flex flex-wrap gap-2">
                  {techNames.map((tech) => (
                    <span class="inline-flex items-center px-3 py-1 rounded-lg bg-primary/10 text-primary text-sm border border-primary/20 hover:bg-primary/20 transition-colors">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            )
          }

          <!-- Action Links -->
          <div class="flex flex-wrap gap-4 pt-4">
            {
              project.link && (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-primary-foreground rounded-lg font-semibold hover:bg-primary/90 transition-colors shadow-lg shadow-primary/20"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                  <span>Live Demo</span>
                </a>
              )
            }
            {
              project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--card)] text-[var(--foreground)] border border-[var(--border)] rounded-lg font-semibold hover:bg-[var(--accent)] transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                  </svg>
                  <span>Source Code</span>
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Smooth slide transition for page content */
  @view-transition {
    navigation: auto;
  }

  /* Animate the main container */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.5s;
  }

  /* Custom slide animation for project images */
  ::view-transition-old(project-image-*),
  ::view-transition-new(project-image-*) {
    animation-duration: 0.6s;
  }

  /* Smooth fade for titles */
  ::view-transition-old(project-title-*),
  ::view-transition-new(project-title-*) {
    animation-duration: 0.4s;
  }
</style>
