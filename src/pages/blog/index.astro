---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const { data } = await Astro.props;
const { posts } = data || { posts: [] };
---

<BaseLayout title="Blog - Bhavesh Patel">
  <Header currentPath="/blog" />
  <main class="min-h-screen py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold text-zinc-900 mb-4">Blog</h1>
      <p class="text-lg text-zinc-600 mb-12">
        Thoughts, tutorials, and articles
      </p>

      {posts.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-zinc-600">No posts yet. Check back soon!</p>
        </div>
      ) : (
        <div class="space-y-8">
          {posts.map(post => (
            <article class="bg-white border border-zinc-200 rounded-lg p-6 hover:shadow-lg transition-shadow">
              <div class="flex flex-col md:flex-row gap-6">
                {post.cover_image_url && (
                  <div class="md:w-64 flex-shrink-0">
                    <img
                      src={post.cover_image_url}
                      alt={post.title}
                      class="w-full h-48 object-cover rounded-md"
                      loading="lazy"
                    />
                  </div>
                )}

                <div class="flex-1">
                  <h2 class="text-2xl font-semibold text-zinc-900 mb-2">
                    <a href={`/blog/${post.slug}`} class="hover:text-zinc-700">
                      {post.title}
                    </a>
                  </h2>
                  <p class="text-zinc-600 mb-4 line-clamp-2">
                    {post.description}
                  </p>
                  <div class="flex items-center text-sm text-zinc-500">
                    <time datetime={post.published_at?.toISOString()}>
                      {post.published_at ? new Date(post.published_at).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      }) : 'Draft'}
                    </time>
                    {post.scheduled_at && (
                      <span class="ml-2 text-amber-600">
                        • Scheduled for {new Date(post.scheduled_at).toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                        })}
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>
